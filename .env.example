# Copy to .env and replace every change-me value. Never commit .env.
APP_ENV=dev

REDIS_URL=redis://redis:6379/0

POSTGRES_USER=farq
POSTGRES_PASSWORD=change-me
POSTGRES_DB=farq

# S3-compatible media store (SeaweedFS in docker-compose)
S3_ENDPOINT_URL=http://s3:8333
S3_ACCESS_KEY=farq
S3_SECRET_KEY=change-me
S3_BUCKET=farq-media
