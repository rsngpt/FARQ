# Copy to .env and replace every change-me value. Never commit .env.
APP_ENV=dev

REDIS_URL=redis://redis:6379/0

POSTGRES_USER=farq
POSTGRES_PASSWORD=change-me
POSTGRES_DB=farq
# "postgres" inside Docker; from the laptop use POSTGRES_HOST=127.0.0.1
# (not "localhost": on Windows that tries IPv6 first and hangs)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# S3-compatible media store (SeaweedFS in docker-compose)
S3_ENDPOINT_URL=http://s3:8333
S3_ACCESS_KEY=farq
S3_SECRET_KEY=change-me
S3_BUCKET=farq-media

# Key for hashing phone numbers / chat IDs (raw IDs are never stored)
USER_HASH_KEY=change-me
# Key the `farq check` command and other local tools send as X-API-Key
INTAKE_API_KEY=change-me
MAX_UPLOAD_MB=64

# GPU worker. With an NVIDIA GPU: keep both lines as they are.
# Without one: set COMPOSE_PROFILES= (empty) and GPU_QUEUE=cpu, so GPU stages
# run on the CPU worker instead (slowly).
COMPOSE_PROFILES=gpu
GPU_QUEUE=gpu
